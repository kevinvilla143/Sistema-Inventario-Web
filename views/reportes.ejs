<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reportes - TechStore</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f0f7f2;
      --surface: #ffffff;
      --surface2: #e8f5ed;
      --border: rgba(0,0,0,0.08);
      --accent: #1a9e5c;
      --accent-light: #d4f0e3;
      --text: #1a2e25;
      --muted: #6b8070;
      --muted2: #4a6b56;
      --danger: #dc3545;
      --warning: #e08a00;
      --shadow: 0 2px 12px rgba(0,80,40,0.08);
    }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
    }
    body::before {
      content: ''; position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(26,158,92,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(26,158,92,0.04) 1px, transparent 1px);
      background-size: 40px 40px; pointer-events: none; z-index: 0;
    }
    .navbar {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; height: 64px;
      background: rgba(255,255,255,0.92); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 8px rgba(0,80,40,0.06);
    }
    .navbar-brand {
      font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 800;
      display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none;
    }
    .brand-dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 12px var(--accent); }
    .nav-link-btn {
      padding: 7px 16px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 99px; color: var(--muted2); font-size: 0.82rem;
      cursor: pointer; text-decoration: none; transition: all 0.2s;
    }
    .nav-link-btn:hover { background: var(--accent-light); border-color: var(--accent); color: var(--accent); }
    .btn-logout {
      padding: 7px 16px; background: transparent; border: 1px solid var(--border);
      border-radius: 99px; color: var(--muted2); font-size: 0.82rem;
      text-decoration: none; transition: all 0.2s;
    }
    .btn-logout:hover { background: rgba(220,53,69,0.08); border-color: var(--danger); color: var(--danger); }

    main {
      position: relative; z-index: 1;
      max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem;
    }

    .page-header { margin-bottom: 2rem; }
    .page-title { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; margin-bottom: 0.3rem; }
    .page-sub { color: var(--muted); font-size: 0.9rem; }

    /* Tabs */
    .tabs { display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .tab-btn {
      padding: 10px 20px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 99px; font-family: 'DM Sans', sans-serif; font-size: 0.87rem;
      cursor: pointer; transition: all 0.2s; color: var(--muted2); font-weight: 500;
    }
    .tab-btn:hover { background: var(--accent-light); border-color: var(--accent); color: var(--accent); }
    .tab-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* Resumen KPIs */
    .kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .kpi-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.25rem 1.5rem;
      display: flex; align-items: center; gap: 1rem;
      box-shadow: var(--shadow); transition: border-color 0.2s;
    }
    .kpi-card:hover { border-color: var(--accent); }
    .kpi-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0;
    }
    .kpi-icon.green  { background: var(--accent-light); }
    .kpi-icon.blue   { background: rgba(26,130,200,0.1); }
    .kpi-icon.purple { background: rgba(120,80,200,0.1); }
    .kpi-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); }
    .kpi-value { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--text); margin-top: 2px; }

    /* Grilla charts + tabla */
    .report-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .report-grid.full { grid-template-columns: 1fr; }

    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.5rem; box-shadow: var(--shadow);
    }
    .card-title {
      font-family: 'Syne', sans-serif; font-size: 0.95rem; font-weight: 700;
      color: var(--text); margin-bottom: 1.25rem;
      display: flex; align-items: center; gap: 8px;
    }
    .card-title::before { content: ''; width: 3px; height: 14px; background: var(--accent); border-radius: 2px; }

    .chart-wrap { position: relative; height: 260px; }

    /* Tabla productos */
    .prod-table { width: 100%; border-collapse: collapse; font-size: 0.87rem; }
    .prod-table thead tr { background: var(--surface2); }
    .prod-table th {
      padding: 10px 12px; text-align: left; font-size: 0.7rem;
      text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted);
      font-family: 'Syne', sans-serif; font-weight: 600;
    }
    .prod-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
    .prod-table tbody tr:last-child td { border-bottom: none; }
    .prod-table tbody tr:hover { background: var(--surface2); }
    .rank { font-family: 'Syne', sans-serif; font-weight: 700; color: var(--accent); }
    .td-ingreso { font-weight: 600; color: var(--accent); font-family: 'Syne', sans-serif; }
    .empty-state {
      text-align: center; padding: 3rem 1rem; color: var(--muted); font-size: 0.9rem;
    }
    .empty-state div:first-child { font-size: 2.5rem; margin-bottom: 0.5rem; }

    @media (max-width: 768px) {
      .kpi-row { grid-template-columns: 1fr 1fr; }
      .report-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .kpi-row { grid-template-columns: 1fr; }
      main { padding: 1rem; }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <a href="/" class="navbar-brand">
      <div class="brand-dot"></div>
      TechStore
    </a>
    <div style="display:flex;align-items:center;gap:1rem;">
      <a href="/" class="nav-link-btn">← Inventario</a>
      <a href="/perfil" class="nav-link-btn">⚙️ Perfil</a>
      <a href="/logout" class="btn-logout">Cerrar sesión</a>
    </div>
  </nav>

  <main>
    <div class="page-header">
      <h1 class="page-title">📊 Reportes de Ventas</h1>
      <p class="page-sub">Análisis de ventas por día, semana y mes</p>
    </div>

    <!-- TABS -->
    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('hoy', this)">📅 Hoy</button>
      <button class="tab-btn" onclick="showTab('semana', this)">📆 Esta semana</button>
      <button class="tab-btn" onclick="showTab('mes', this)">🗓️ Este mes</button>
    </div>

    <!-- ══ TAB HOY ══ -->
    <div class="tab-content active" id="tab-hoy">
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-icon green">💰</div>
          <div>
            <div class="kpi-label">Ingresos hoy</div>
            <div class="kpi-value">$<%= totHoy.toLocaleString('es-CO', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon blue">📦</div>
          <div>
            <div class="kpi-label">Productos vendidos</div>
            <div class="kpi-value"><%= hoy.reduce((s,r)=>s+parseInt(r.unidades),0) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon purple">🏷️</div>
          <div>
            <div class="kpi-label">Referencias distintas</div>
            <div class="kpi-value"><%= hoy.length %></div>
          </div>
        </div>
      </div>

      <% if (hoy.length === 0) { %>
        <div class="card"><div class="empty-state"><div>📭</div>No hay ventas registradas hoy todavía.</div></div>
      <% } else { %>
      <div class="report-grid">
        <div class="card">
          <div class="card-title">Unidades vendidas hoy</div>
          <div class="chart-wrap"><canvas id="chartHoyBar"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Ingresos por producto (hoy)</div>
          <div class="chart-wrap"><canvas id="chartHoyPie"></canvas></div>
        </div>
      </div>
      <div class="card" style="margin-top:1.5rem;">
        <div class="card-title">Detalle de ventas — Hoy</div>
        <table class="prod-table">
          <thead><tr><th>#</th><th>Producto</th><th>Unidades</th><th>Ingresos</th></tr></thead>
          <tbody>
            <% hoy.forEach((r,i) => { %>
            <tr>
              <td class="rank">#<%= i+1 %></td>
              <td><%= r.producto_nombre %></td>
              <td><%= r.unidades %> uds</td>
              <td class="td-ingreso">$<%= parseFloat(r.ingresos).toLocaleString('es-CO',{minimumFractionDigits:0,maximumFractionDigits:0}) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- ══ TAB SEMANA ══ -->
    <div class="tab-content" id="tab-semana">
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-icon green">💰</div>
          <div>
            <div class="kpi-label">Ingresos semana</div>
            <div class="kpi-value">$<%= totSemana.toLocaleString('es-CO',{minimumFractionDigits:0,maximumFractionDigits:0}) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon blue">📦</div>
          <div>
            <div class="kpi-label">Unidades vendidas</div>
            <div class="kpi-value"><%= semana.reduce((s,r)=>s+parseInt(r.unidades),0) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon purple">🏷️</div>
          <div>
            <div class="kpi-label">Productos distintos</div>
            <div class="kpi-value"><%= semana.length %></div>
          </div>
        </div>
      </div>

      <% if (semana.length === 0) { %>
        <div class="card"><div class="empty-state"><div>📭</div>No hay ventas registradas esta semana todavía.</div></div>
      <% } else { %>
      <div class="report-grid">
        <div class="card">
          <div class="card-title">Ingresos diarios (últimos 7 días)</div>
          <div class="chart-wrap"><canvas id="chartSemanaLine"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Top productos — semana</div>
          <div class="chart-wrap"><canvas id="chartSemanaPie"></canvas></div>
        </div>
      </div>
      <div class="card" style="margin-top:1.5rem;">
        <div class="card-title">Detalle de ventas — Esta semana</div>
        <table class="prod-table">
          <thead><tr><th>#</th><th>Producto</th><th>Unidades</th><th>Ingresos</th></tr></thead>
          <tbody>
            <% semana.forEach((r,i) => { %>
            <tr>
              <td class="rank">#<%= i+1 %></td>
              <td><%= r.producto_nombre %></td>
              <td><%= r.unidades %> uds</td>
              <td class="td-ingreso">$<%= parseFloat(r.ingresos).toLocaleString('es-CO',{minimumFractionDigits:0,maximumFractionDigits:0}) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- ══ TAB MES ══ -->
    <div class="tab-content" id="tab-mes">
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-icon green">💰</div>
          <div>
            <div class="kpi-label">Ingresos del mes</div>
            <div class="kpi-value">$<%= totMes.toLocaleString('es-CO',{minimumFractionDigits:0,maximumFractionDigits:0}) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon blue">📦</div>
          <div>
            <div class="kpi-label">Unidades vendidas</div>
            <div class="kpi-value"><%= mes.reduce((s,r)=>s+parseInt(r.unidades),0) %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon purple">🏷️</div>
          <div>
            <div class="kpi-label">Productos distintos</div>
            <div class="kpi-value"><%= mes.length %></div>
          </div>
        </div>
      </div>

      <% if (mes.length === 0) { %>
        <div class="card"><div class="empty-state"><div>📭</div>No hay ventas registradas este mes todavía.</div></div>
      <% } else { %>
      <div class="report-grid">
        <div class="card">
          <div class="card-title">Top 5 — más vendidos del mes</div>
          <div class="chart-wrap"><canvas id="chartMesBar"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title">Distribución ingresos del mes</div>
          <div class="chart-wrap"><canvas id="chartMesPie"></canvas></div>
        </div>
      </div>
      <div class="card" style="margin-top:1.5rem;">
        <div class="card-title">Detalle de ventas — Este mes</div>
        <table class="prod-table">
          <thead><tr><th>#</th><th>Producto</th><th>Unidades</th><th>Ingresos</th></tr></thead>
          <tbody>
            <% mes.forEach((r,i) => { %>
            <tr>
              <td class="rank">#<%= i+1 %></td>
              <td><%= r.producto_nombre %></td>
              <td><%= r.unidades %> uds</td>
              <td class="td-ingreso">$<%= parseFloat(r.ingresos).toLocaleString('es-CO',{minimumFractionDigits:0,maximumFractionDigits:0}) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </main>

  <script>
    // ── Datos desde servidor ──
    const dataHoy    = <%- JSON.stringify(hoy) %>;
    const dataSemana = <%- JSON.stringify(semana) %>;
    const dataMes    = <%- JSON.stringify(mes) %>;
    const dataIngresosSem = <%- JSON.stringify(ingresosSemanales) %>;

    const COLORS = ['#1a9e5c','#2ec47a','#57d99a','#8eeabb','#b8f5d4','#d4f0e3','#a3e4c1','#5cc896'];
    const BORDER = COLORS.map(c => c);

    const chartDefaults = {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: '#1a2e25', font: { family: 'DM Sans' }, boxWidth: 12 } },
        tooltip: { callbacks: {
          label: ctx => {
            const val = ctx.parsed.y ?? ctx.parsed;
            return typeof val === 'number' && ctx.dataset.label?.includes('$')
              ? ` $${val.toLocaleString('es-CO')}`
              : ` ${val}`;
          }
        }}
      },
      scales: {
        x: { ticks: { color: '#6b8070', font: { family: 'DM Sans', size: 11 } }, grid: { color: 'rgba(0,0,0,0.05)' } },
        y: { ticks: { color: '#6b8070', font: { family: 'DM Sans', size: 11 } }, grid: { color: 'rgba(0,0,0,0.05)' } }
      }
    };

    function makeBar(id, labels, data, label) {
      const ctx = document.getElementById(id);
      if (!ctx) return;
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{ label, data, backgroundColor: COLORS.slice(0, data.length), borderRadius: 8, borderSkipped: false }]
        },
        options: { ...chartDefaults, plugins: { ...chartDefaults.plugins, legend: { display: false } } }
      });
    }

    function makePie(id, labels, data) {
      const ctx = document.getElementById(id);
      if (!ctx) return;
      new Chart(ctx, {
        type: 'doughnut',
        data: { labels, datasets: [{ data, backgroundColor: COLORS.slice(0, data.length), borderWidth: 2, borderColor: '#fff' }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: '#1a2e25', font: { family: 'DM Sans' }, boxWidth: 12, padding: 12 } }
          }
        }
      });
    }

    function makeLine(id, labels, data) {
      const ctx = document.getElementById(id);
      if (!ctx) return;
      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Ingresos ($)',
            data,
            borderColor: '#1a9e5c',
            backgroundColor: 'rgba(26,158,92,0.08)',
            borderWidth: 2.5,
            pointBackgroundColor: '#1a9e5c',
            pointRadius: 5,
            fill: true,
            tension: 0.35
          }]
        },
        options: { ...chartDefaults }
      });
    }

    // ── HOY ──
    if (dataHoy.length > 0) {
      makeBar('chartHoyBar', dataHoy.map(r=>r.producto_nombre), dataHoy.map(r=>parseInt(r.unidades)), 'Unidades');
      makePie('chartHoyPie', dataHoy.map(r=>r.producto_nombre), dataHoy.map(r=>parseFloat(r.ingresos)));
    }

    // ── SEMANA ──
    if (dataSemana.length > 0) {
      makeLine('chartSemanaLine', dataIngresosSem.map(r=>r.dia), dataIngresosSem.map(r=>parseFloat(r.total)));
      makePie('chartSemanaPie', dataSemana.map(r=>r.producto_nombre), dataSemana.map(r=>parseFloat(r.ingresos)));
    }

    // ── MES ──
    if (dataMes.length > 0) {
      const top5 = dataMes.slice(0,5);
      makeBar('chartMesBar', top5.map(r=>r.producto_nombre), top5.map(r=>parseInt(r.unidades)), 'Unidades');
      makePie('chartMesPie', dataMes.map(r=>r.producto_nombre), dataMes.map(r=>parseFloat(r.ingresos)));
    }

    // ── TABS ──
    function showTab(id, btn) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + id).classList.add('active');
      btn.classList.add('active');
    }
  </script>
</body>
</html>
