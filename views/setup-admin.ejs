<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configurar Administrador - Inventario</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <canvas id="stars"></canvas>
  <div class="auth-bg">
    <div class="auth-card">
<% if (locals.flash) { %>
  <div class="alert alert-<%= flash.type %> py-2" role="alert">
    <%= flash.message %>
  </div>
<% } %>
      <!-- LOGO -->
      <div class="auth-logo">
        <img src="/peppa.jpg" alt="logo">
      </div>

      <h3>Configurar Administrador</h3>
      <p class="auth-sub">Esta es tu primera vez. Cambia tu usuario y contraseña</p>

      <div class="alert alert-info" role="alert">
        ⚠️ <strong>Importante:</strong> Esta es la única vez que podrás usar esta cuenta de administrador. Después de completar esta configuración, la cuenta será desactivada por seguridad.
      </div>

      <form method="POST" action="/setup-admin">

        <div class="form-gap">
          <label class="form-label">Nuevo Usuario</label>
          <input name="nuevoUsername" class="form-control" placeholder="nuevo_usuario_admin" required minlength="3" maxlength="50" pattern="[a-zA-Z0-9_]+">
          <small class="text-muted">Solo letras, números y guiones bajos</small>
        </div>

        <div class="form-gap">
          <label class="form-label">Nueva Contraseña</label>
          <input name="nuevoPassword" type="password" class="form-control" placeholder="••••••••" required minlength="6">
          <small class="text-muted">Mínimo 6 caracteres</small>
        </div>

        <div class="form-gap">
          <label class="form-label">Confirmar Contraseña</label>
          <input name="confirmarPassword" type="password" class="form-control" placeholder="••••••••" required minlength="6">
        </div>

        <div style="margin-top:1.5rem;">
          <button class="btn btn-success w-100" style="padding:.75rem;">Completar Configuración</button>
        </div>

      </form>

    </div>
  </div>
<script>
window.onload = function(){

const canvas = document.getElementById("stars");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let stars = [];

for(let i = 0; i < 120; i++){
  stars.push({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    size: Math.random() * 2,
    speed: Math.random() * 0.5
  });
}

function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  ctx.fillStyle = "white";

  stars.forEach(star => {
    ctx.beginPath();
    ctx.arc(star.x, star.y, star.size, 0, Math.PI*2);
    ctx.fill();

    star.y += star.speed;

    if(star.y > canvas.height){
      star.y = 0;
      star.x = Math.random() * canvas.width;
    }
  });

  requestAnimationFrame(draw);
}

draw();

}
</script>
</body>
</html>
