<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perfil Admin - TechStore</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f0f7f2;
      --surface: #ffffff;
      --surface2: #e8f5ed;
      --border: rgba(0,0,0,0.08);
      --accent: #1a9e5c;
      --accent-light: #d4f0e3;
      --text: #1a2e25;
      --muted: #6b8070;
      --muted2: #4a6b56;
      --danger: #dc3545;
      --shadow: 0 2px 12px rgba(0,80,40,0.08);
    }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg); color: var(--text);
      min-height: 100vh;
    }
    body::before {
      content: ''; position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(26,158,92,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(26,158,92,0.04) 1px, transparent 1px);
      background-size: 40px 40px; pointer-events: none; z-index: 0;
    }
    .navbar {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; height: 64px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 8px rgba(0,80,40,0.06);
    }
    .navbar-brand {
      font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 800;
      display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none;
    }
    .brand-dot {
      width: 8px; height: 8px; background: var(--accent);
      border-radius: 50%; box-shadow: 0 0 12px var(--accent);
    }
    .nav-link-btn {
      padding: 7px 16px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 99px; color: var(--muted2); font-size: 0.82rem;
      cursor: pointer; text-decoration: none; transition: all 0.2s;
    }
    .nav-link-btn:hover { background: var(--accent-light); border-color: var(--accent); color: var(--accent); }
    .btn-logout {
      padding: 7px 16px; background: transparent; border: 1px solid var(--border);
      border-radius: 99px; color: var(--muted2); font-size: 0.82rem;
      text-decoration: none; transition: all 0.2s;
    }
    .btn-logout:hover { background: rgba(220,53,69,0.08); border-color: var(--danger); color: var(--danger); }

    main {
      position: relative; z-index: 1;
      max-width: 640px; margin: 0 auto; padding: 2.5rem 1.5rem;
    }

    .page-title {
      font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800;
      margin-bottom: 0.4rem; color: var(--text);
    }
    .page-sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }

    .flash-msg {
      padding: 12px 16px; border-radius: 10px; font-size: 0.875rem;
      margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;
    }
    .flash-danger  { background: #fde8e8; border: 1px solid #f5b8b8; color: #8b1a1a; }
    .flash-success { background: #d4f0e3; border: 1px solid #a3ddc1; color: #0e6b3a; }

    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 16px; padding: 2rem; box-shadow: var(--shadow);
    }

    .card-title {
      font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700;
      color: var(--text); margin-bottom: 0.3rem;
      display: flex; align-items: center; gap: 8px;
    }
    .card-desc { font-size: 0.82rem; color: var(--muted); margin-bottom: 1.75rem; }

    .divider {
      height: 1px; background: var(--border); margin: 1.5rem 0;
    }

    .section-label {
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;
      color: var(--muted); margin-bottom: 1rem; font-weight: 600;
      display: flex; align-items: center; gap: 6px;
    }
    .section-label::before {
      content: ''; width: 3px; height: 12px;
      background: var(--accent); border-radius: 2px;
    }

    .form-group { margin-bottom: 1rem; }
    .form-label {
      display: block; font-size: 0.78rem; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.4rem;
    }
    .form-input {
      width: 100%; padding: 0.7rem 1rem;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; color: var(--text);
      font-family: 'DM Sans', sans-serif; font-size: 0.9rem;
      outline: none; transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input::placeholder { color: var(--muted); }
    .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(26,158,92,0.1); }

    .input-hint { font-size: 0.72rem; color: var(--muted); margin-top: 4px; }

    .required-note {
      background: #fff8e6; border: 1px solid #ffe08a; border-radius: 10px;
      padding: 10px 14px; font-size: 0.82rem; color: #7a5500;
      margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 8px;
    }

    .btn-save {
      width: 100%; padding: 0.85rem;
      background: var(--accent); border: none; border-radius: 10px;
      color: #fff; font-family: 'Syne', sans-serif; font-size: 0.95rem; font-weight: 700;
      cursor: pointer; transition: all 0.2s; margin-top: 1.5rem;
    }
    .btn-save:hover { background: #158a4e; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(26,158,92,0.25); }

    .current-user-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--accent-light); border: 1px solid rgba(26,158,92,0.25);
      border-radius: 99px; padding: 6px 14px; font-size: 0.85rem;
      color: var(--muted2); margin-bottom: 1.75rem;
    }
    .current-user-badge strong { color: var(--accent); }
  </style>
</head>
<body>

  <nav class="navbar">
    <a href="/" class="navbar-brand">
      <div class="brand-dot"></div>
      TechStore
    </a>
    <div style="display:flex;align-items:center;gap:1rem;">
      <a href="/" class="nav-link-btn">← Inventario</a>
      <a href="/reportes" class="nav-link-btn">📊 Reportes</a>
      <a href="/logout" class="btn-logout">Cerrar sesión</a>
    </div>
  </nav>

  <main>
    <h1 class="page-title">⚙️ Perfil Admin</h1>
    <p class="page-sub">Cambia tu nombre de usuario o contraseña de acceso</p>

    <% if (locals.flash) { %>
      <div class="flash-msg flash-<%= flash.type %>">
        <%= flash.type === 'success' ? '✓' : '✕' %> <%= flash.message %>
      </div>
    <% } %>

    <div class="card">
      <div class="card-title">🔐 Actualizar credenciales</div>
      <p class="card-desc">Debes ingresar tu contraseña actual para confirmar cualquier cambio.</p>

      <div class="current-user-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        Usuario actual: <strong><%= usuario %></strong>
      </div>

      <div class="required-note">
        ⚠️ La <strong>contraseña actual</strong> es obligatoria. Los campos de usuario y contraseña nueva son opcionales — solo cambia lo que necesites.
      </div>

      <form method="POST" action="/perfil/cambiar">

        <!-- Contraseña actual (OBLIGATORIA) -->
        <div class="section-label">Verificación</div>
        <div class="form-group">
          <label class="form-label">Contraseña actual *</label>
          <input type="password" name="password_actual" class="form-input"
                 placeholder="••••••••" required autocomplete="current-password">
          <div class="input-hint">Requerida para confirmar cualquier cambio</div>
        </div>

        <div class="divider"></div>

        <!-- Nuevo usuario (opcional) -->
        <div class="section-label">Nuevo nombre de usuario (opcional)</div>
        <div class="form-group">
          <label class="form-label">Nuevo usuario</label>
          <input type="text" name="nuevo_username" class="form-input"
                 placeholder="Dejar vacío para no cambiar"
                 autocomplete="username"
                 pattern="[a-zA-Z0-9_]{3,50}"
                 title="Solo letras, números y guión bajo. Mínimo 3 caracteres.">
          <div class="input-hint">Solo letras, números y _ (guión bajo). Mínimo 3 caracteres.</div>
        </div>

        <div class="divider"></div>

        <!-- Nueva contraseña (opcional) -->
        <div class="section-label">Nueva contraseña (opcional)</div>
        <div class="form-group">
          <label class="form-label">Nueva contraseña</label>
          <input type="password" name="nuevo_password" class="form-input"
                 placeholder="Dejar vacío para no cambiar"
                 autocomplete="new-password" minlength="6">
          <div class="input-hint">Mínimo 6 caracteres</div>
        </div>
        <div class="form-group">
          <label class="form-label">Confirmar nueva contraseña</label>
          <input type="password" name="confirmar_password" class="form-input"
                 placeholder="Repite la nueva contraseña"
                 autocomplete="new-password">
        </div>

        <button type="submit" class="btn-save">Guardar cambios</button>
      </form>
    </div>
  </main>

</body>
</html>
